package pages

import (
	"github.com/SkyvisorInsights/Aviation-tracker/app/models"
	"github.com/SkyvisorInsights/Aviation-tracker/app/view/components"
	"github.com/FACorreiaa/Thinking-orbs-go/components/orb"
)

templ LayoutPage(l models.LayoutTempl) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			// htmx 4 swaps every response except 204 and 304, where htmx 2 left
			// 4xx and 5xx alone. Every non-2xx this app returns is a plain-text
			// http.Error, so none of them are page content; an element that does
			// want one swapped opts in with hx-status:<code>.
			<meta name="htmx-config" content='{"noSwap": [204, 304, "4xx", "5xx"]}'/>
			<meta name="theme-color" content="#f7f9fc"/>
			<meta name="description" content="Track flights, organize trips, and get useful travel alerts with SkyVisor Insight."/>
			<title>{ l.Title } - SkyVisor Insight</title>
			<link rel="stylesheet" href="/static/css/maplibre-gl.css"/>
			<link rel="stylesheet" href="/static/css/app.css"/>
			<script src="/static/js/theme.js"></script>
			if l.LegacyMap {
				// Reference and Explorer pages draw their maps from an inline
				// script against the global `ol`, so this must load before the
				// body parses and cannot be deferred.
				<script src="/static/js/ol.js"></script>
			}
			<script src="/static/js/arc.js"></script>
			<script defer src="/static/js/app.js"></script>
			@orb.Script()
			@components.PostHogSnippet(l.User)
		</head>
		<body hx-boost:inherited="true" x-data="appShell" lang="en">
			<a href="#main-content" class="sr-only z-[60] rounded-md bg-primary px-4 py-2 text-primary-foreground focus:not-sr-only focus:fixed focus:left-4 focus:top-4">Skip to content</a>
			if l.Variant == models.LayoutCanvas {
				<div class="relative flex h-[100dvh] flex-col overflow-hidden" id="contents">
					@components.NavbarComponent(l.Nav, l.User, l.ActiveNav, l.CSRFToken)
					<main class="relative min-h-0 flex-1 overflow-hidden" id="main-content">
						@l.Content
					</main>
				</div>
			} else {
				<div class="flex min-h-screen flex-col" id="contents">
					@components.NavbarComponent(l.Nav, l.User, l.ActiveNav, l.CSRFToken)
					<main class="flex-1" id="main-content">
						@l.Content
					</main>
					@components.FooterComponent()
				</div>
			}
		</body>
	</html>
}
