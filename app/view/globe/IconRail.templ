package globe

import svg2 "github.com/SkyvisorInsights/Aviation-tracker/app/static/svg"

// IconRail is the left navigation strip.
//
// Icon-only navigation without accessible names is an accessibility failure, so
// every link carries an aria-label and a tooltip title, and the current page is
// marked with aria-current.
templ IconRail() {
	<nav class="pointer-events-auto hidden w-14 shrink-0 flex-col items-center gap-1 border-r border-border/60 bg-card/70 py-4 backdrop-blur-md sm:flex" aria-label="Views">
		@railLink("/globe", "Global view", true) {
			@svg2.GlobeIcon()
		}
		@railLink("/dashboard", "Operations dashboard", false) {
			@svg2.MapIcon()
		}
		@railLink("/watches", "Watched flights", false) {
			@svg2.AirplaneIcon()
		}
		@railLink("/analytics", "Analytics", false) {
			@svg2.LocationsIcon()
		}
	</nav>
}

templ railLink(href string, label string, active bool) {
	<a
		href={ templ.SafeURL(href) }
		title={ label }
		aria-label={ label }
		if active {
			aria-current="page"
		}
		class={
			"flex h-10 w-10 items-center justify-center rounded-lg transition-colors",
			templ.KV("bg-primary/15 text-primary", active),
			templ.KV("text-muted-foreground hover:bg-muted/60 hover:text-foreground", !active),
		}
	>
		{ children... }
	</a>
}
