package globe

import (
	"encoding/json"
	"fmt"
	"strconv"
)

// View is everything the globe page renders.
type View struct {
	Envelope   Envelope
	Message    string
	Attention  []AttentionRow
	Ortho      Ortho
	BootstrapJSON string
}

// AttentionRow is one row of the Activities drawer. It doubles as the
// accessible equivalent of the canvas: every row is focusable and describes a
// thing drawn on the globe.
type AttentionRow struct {
	ID       string
	Severity string
	Title    string
	Flight   string
	Route    string
	Dep      string
	Arr      string
	Reason   string
	Risk     string
	Lon      float64
	Lat      float64
	HasPoint bool
}

templ Page(v View) {
	<section
		id="globe-view"
		class="relative flex h-full w-full flex-col overflow-hidden bg-[var(--map-ocean)]"
		data-globe-root
		data-live-refresh-url="/globe?partial=globe"
		data-live-refresh-target="#globe-view"
	>
		@bootstrap(v)
		<div class="pointer-events-none absolute inset-0 z-0 flex items-center justify-center">
			@GlobeSVG(v)
		</div>
		<div class="relative z-10 flex min-h-0 flex-1">
			@IconRail()
			<div class="flex min-h-0 flex-1 flex-col">
				@header(v)
				<div class="flex min-h-0 flex-1 items-start justify-end px-4 pb-4 sm:px-6">
					@StatsRail(v)
				</div>
				@Activities(v)
			</div>
		</div>
	</section>
}

// bootstrap embeds the envelope so the map bundle can hydrate without a second
// request. Read by the globe module on load and on htmx swaps.
templ bootstrap(v View) {
	@templ.Raw(`<script type="application/json" id="globe-bootstrap">` + v.BootstrapJSON + `</script>`)
}

templ header(v View) {
	<header class="flex flex-col items-center gap-1 px-4 pt-5 text-center sm:px-6">
		<h1 class="text-2xl font-semibold tracking-tight sm:text-3xl">Global view</h1>
		<div class="flex items-center gap-2 text-[11px] font-medium uppercase tracking-[0.16em] text-muted-foreground">
			if v.Envelope.Stats.HasOperations {
				<span class="inline-flex h-1.5 w-1.5 rounded-full bg-emerald-400" aria-hidden="true"></span>
				<span>{ fmt.Sprintf("%d watched · %d observed", v.Envelope.Stats.WatchedFlights, v.Envelope.Stats.Flights) }</span>
			} else {
				<span class="inline-flex h-1.5 w-1.5 rounded-full bg-muted-foreground/50" aria-hidden="true"></span>
				<span>Live operations unavailable</span>
			}
			<span aria-hidden="true">·</span>
			<span>{ fmt.Sprintf("%d day window", v.Envelope.WindowDays) }</span>
		</div>
		if v.Message != "" {
			<p class="mt-2 max-w-xl text-sm text-muted-foreground">{ v.Message }</p>
		}
	</header>
}

// GlobeSVG is the server-rendered globe. It is the real first paint, not a
// placeholder: with JavaScript or WebGL unavailable this is the whole view.
templ GlobeSVG(v View) {
	<svg
		viewBox={ SVGViewBox() }
		class="h-full max-h-[min(78vh,52rem)] w-auto"
		role="img"
		aria-label={ AltText(v.Envelope.Stats, v.Envelope.Unresolved) }
		data-globe-svg
	>
		<defs>
			<radialGradient id="globe-atmosphere" cx="50%" cy="50%" r="50%">
				<stop offset="88%" stop-color="var(--map-atmosphere)" stop-opacity="0"></stop>
				<stop offset="100%" stop-color="var(--map-atmosphere)" stop-opacity="0.55"></stop>
			</radialGradient>
			<clipPath id="globe-clip">
				<circle cx={ coord(SphereCenter()) } cy={ coord(SphereCenter()) } r={ coord(SphereRadius()) }></circle>
			</clipPath>
		</defs>
		<circle
			cx={ coord(SphereCenter()) }
			cy={ coord(SphereCenter()) }
			r={ coord(SphereRadius() + 26) }
			fill="url(#globe-atmosphere)"
		></circle>
		<circle
			cx={ coord(SphereCenter()) }
			cy={ coord(SphereCenter()) }
			r={ coord(SphereRadius()) }
			fill="var(--map-ocean)"
		></circle>
		<g clip-path="url(#globe-clip)">
			<path d={ v.Ortho.GraticulePath() } fill="none" stroke="var(--map-graticule)" stroke-width="1" opacity="0.5"></path>
			<path d={ v.Ortho.LandPath() } fill="var(--map-land)" stroke="var(--map-boundary)" stroke-width="0.8" fill-rule="evenodd"></path>
			<path d={ v.Ortho.RoutePath(v.Envelope.Routes, RiskOK) } fill="none" stroke="var(--map-arc-ok)" stroke-width="1.6" stroke-linecap="round" opacity="0.85"></path>
			<path d={ v.Ortho.RoutePath(v.Envelope.Routes, RiskWatch) } fill="none" stroke="var(--map-arc-watch)" stroke-width="2" stroke-linecap="round" opacity="0.9"></path>
			<path d={ v.Ortho.RoutePath(v.Envelope.Routes, RiskRisk) } fill="none" stroke="var(--map-arc-risk)" stroke-width="2.4" stroke-linecap="round"></path>
			for _, hub := range v.Ortho.HubCircles(v.Envelope.Hubs) {
				<circle
					cx={ coord(hub.X) }
					cy={ coord(hub.Y) }
					r={ coord(hub.Radius) }
					fill={ hubFill(hub.Risk) }
					fill-opacity="0.85"
					stroke="var(--map-ocean)"
					stroke-width="1"
				>
					<title>{ hub.IATA }</title>
				</circle>
			}
		</g>
		<circle
			cx={ coord(SphereCenter()) }
			cy={ coord(SphereCenter()) }
			r={ coord(SphereRadius()) }
			fill="none"
			stroke="var(--map-atmosphere)"
			stroke-opacity="0.35"
			stroke-width="1.5"
		></circle>
	</svg>
}

func coord(value float64) string {
	return strconv.FormatFloat(value, 'f', 1, 64)
}

func hubFill(risk string) string {
	switch risk {
	case RiskRisk:
		return "var(--map-arc-risk)"
	case RiskWatch:
		return "var(--map-arc-watch)"
	default:
		return "var(--map-hub)"
	}
}

// MarshalBootstrap serialises the envelope for the inline bootstrap script.
// Errors collapse to an empty object so a serialisation failure degrades the
// map rather than breaking the page.
func MarshalBootstrap(envelope Envelope) string {
	encoded, err := json.Marshal(envelope)
	if err != nil {
		return "{}"
	}
	return string(encoded)
}
