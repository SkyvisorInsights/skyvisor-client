package situation

import "fmt"

// Page is the global situation monitor: a full-bleed globe with a rail of
// independently toggleable layers.
//
// The layer rail is server-rendered from the catalogue rather than hardcoded,
// so a layer added server-side appears here without a client release.
templ Page(v View) {
	<div class="flex min-h-0 flex-1 flex-col" x-data="situationPage()">
		<script type="application/json" id="situation-bootstrap">
			@templ.Raw(v.BootstrapJSON())
		</script>
		<div class="relative flex min-h-0 flex-1">
			<div class="absolute inset-0 z-0">
				<div
					id="situation-canvas"
					data-skyvisor-map
					data-map-mode="situation"
					data-globe-bootstrap="#situation-bootstrap"
					data-map-fallback="#situation-fallback"
					data-map-gestures="direct"
					data-latitude="20"
					data-longitude="0"
					data-zoom="1.3"
					class="h-full w-full"
					aria-hidden="true"
				></div>
				<div id="situation-fallback" class="pointer-events-none absolute inset-0 flex items-center justify-center">
					@Fallback(v)
				</div>
			</div>
			<div class="relative z-10 flex min-h-0 flex-1 justify-between">
				@LayerRail(v)
				@NewsRail(v.News)
			</div>
		</div>
		@AlertStack()
		@AttributionBar(v)
	</div>
}

// LayerRail lists every layer in three states: switchable, locked behind a
// plan, and not configured on this deployment. They are kept visually distinct
// because only one of them is fixed by upgrading.
templ LayerRail(v View) {
	<aside class="m-3 flex w-72 flex-col gap-3 overflow-y-auto rounded-lg border border-border bg-background/85 p-3 backdrop-blur">
		<div>
			<h1 class="text-sm font-semibold">Global situation</h1>
			<p class="text-xs text-muted-foreground">
				{ fmt.Sprintf("%d layers available", len(v.Entitled())) }
			</p>
		</div>
		if v.Unavailable != "" {
			<p class="rounded-md border border-border bg-muted/40 p-2 text-xs text-muted-foreground">
				{ v.Unavailable }
			</p>
		}
		if len(v.Entitled()) > 0 {
			<div class="flex flex-col gap-1">
				for _, layer := range v.Entitled() {
					<label class="flex cursor-pointer items-center gap-2 rounded-md px-2 py-1.5 text-sm hover:bg-muted/60">
						<input
							type="checkbox"
							class="size-3.5 rounded border-border"
							value={ layer.ID }
							x-on:change={ fmt.Sprintf("toggle('%s', $event.target.checked)", layer.ID) }
						/>
						<span class="flex-1 truncate">{ layer.Label }</span>
						if layer.Count > 0 {
							<span class="text-xs tabular-nums text-muted-foreground">{ fmt.Sprintf("%d", layer.Count) }</span>
						}
					</label>
				}
			</div>
		}
		if len(v.Locked()) > 0 {
			<div class="flex flex-col gap-1 border-t border-border pt-2">
				<p class="px-2 text-xs font-medium text-muted-foreground">Upgrade to unlock</p>
				for _, layer := range v.Locked() {
					<a href="/pricing" class="flex items-center gap-2 rounded-md px-2 py-1.5 text-sm text-muted-foreground hover:bg-muted/60">
						<span class="flex-1 truncate">{ layer.Label }</span>
						<span class="text-xs uppercase">{ string(layer.MinPlan) }</span>
					</a>
				}
			</div>
		}
		if len(v.Unconfigured()) > 0 {
			<div class="flex flex-col gap-1 border-t border-border pt-2">
				<p class="px-2 text-xs font-medium text-muted-foreground">Not configured</p>
				for _, layer := range v.Unconfigured() {
					<span class="truncate px-2 py-1 text-sm text-muted-foreground/70">{ layer.Label }</span>
				}
			</div>
		}
	</aside>
}

// Fallback is what a visitor without WebGL sees.
//
// It states plainly that the map needs WebGL rather than showing an empty
// square, and the rail beside it still lists every layer and its count, so the
// page remains informative rather than merely broken.
templ Fallback(v View) {
	<div class="max-w-sm rounded-lg border border-border bg-background/85 p-4 text-center text-sm text-muted-foreground backdrop-blur">
		<p>The situation globe needs WebGL, which this browser has not made available.</p>
		<p class="mt-2">
			{ fmt.Sprintf("%d layers are being monitored. Counts are listed beside each layer.", len(v.Entitled())) }
		</p>
	</div>
}

// AttributionBar credits every upstream on screen.
//
// Several of these sources permit reuse only with credit, so this is a licence
// obligation rather than a courtesy, and it is rendered from the catalogue so a
// new layer cannot ship without its credit.
templ AttributionBar(v View) {
	if len(v.Attributions()) > 0 {
		<footer class="border-t border-border bg-background/85 px-3 py-1.5 text-[11px] text-muted-foreground backdrop-blur">
			<span>Sources: </span>
			for index, credit := range v.Attributions() {
				if index > 0 {
					<span> · </span>
				}
				<span>{ credit }</span>
			}
			<span> · </span>
			<a href="/legal/data-sources" class="underline hover:no-underline">Licences</a>
		</footer>
	}
}


// AlertStack renders live alerts raised by the map module.
//
// Deliberately non-modal and dismissible: an alert about a cyclone on the other
// side of the world must not block the map someone is reading. Announced
// politely so a screen reader is told without being interrupted.
templ AlertStack() {
	<div
		class="pointer-events-none absolute right-4 top-4 z-20 flex w-80 flex-col gap-2"
		role="status"
		aria-live="polite"
	>
		<template x-for="alert in alerts" x-bind:key="alert.id">
			<div class="pointer-events-auto flex items-start gap-2 rounded-lg border border-border bg-background/95 p-3 shadow-lg backdrop-blur">
				<span class="mt-0.5 size-2 shrink-0 rounded-full bg-[var(--map-situation-severe,#f2555a)]"></span>
				<span class="flex-1 text-sm leading-snug" x-text="alert.message"></span>
				<button
					type="button"
					class="shrink-0 text-xs text-muted-foreground hover:text-foreground"
					x-on:click="dismiss(alert.id)"
					aria-label="Dismiss alert"
				>&times;</button>
			</div>
		</template>
	</div>
}
